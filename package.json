{
  "name": "teampilot",
  "version": "0.1.0",
  "description": "Team operations autopilot for Microsoft Teams: daily standups, weekly timesheet compliance, leave tracking, a weekly leadership report, and a supervisor that checks every card.",
  "author": "Kumar Gourabh <kumargourabh94@gmail.com>",
  "homepage": "https://github.com/Kumar-Gourabh/teampilot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kumar-Gourabh/teampilot.git"
  },
  "bugs": {
    "url": "https://github.com/Kumar-Gourabh/teampilot/issues"
  },
  "keywords": [
    "microsoft-teams",
    "standup",
    "timesheet",
    "leave-tracker",
    "automation",
    "microsoft-graph",
    "claude",
    "ai",
    "team-operations"
  ],
  "bin": {
    "teampilot": "bin/teampilot.js"
  },
  "main": "src/index.js",
  "files": [
