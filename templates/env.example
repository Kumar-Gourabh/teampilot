# Secrets for this workspace. Never commit this file. Keep it chmod 600.
#
# Teams Workflows webhook URLs — one per venue in workspace.yaml.
# In Teams: channel or chat → ⋯ → Workflows → "Post to a channel/chat when a
# webhook request is received" → copy the URL. Create the flows from an account
# that will stay (a service account), not a person who may leave.
WEBHOOK_STANDUP=
WEBHOOK_TIMESHEET=
WEBHOOK_LEAVE=
WEBHOOK_LEADERSHIP=
WEBHOOK_ALERTS=

# LLM
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
